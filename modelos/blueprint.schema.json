{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint-backend/blueprint.schema.json",
  "title": "Blueprint do backend",
  "description": "Modelo conceitual de um backend (conceitos e relações) com os fluxos desenhados sobre ele. Referências entre ids são conferidas por modelos/validar.mjs.",
  "type": "object",
  "required": ["project", "concepts", "relations", "flows"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source": { "type": "string", "description": "Repositório e caminho de onde o modelo saiu." },
        "generatedAt": { "type": "string", "description": "Data do levantamento (AAAA-MM-DD)." },
        "locale": { "type": "string", "description": "Idioma da interface do visualizador: \"pt-BR\" (padrão) ou \"en\". Os textos do modelo ficam no idioma em que foram escritos." }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1, "description": "Nome humano, no idioma do produto." },
          "code": { "type": "string", "description": "Nome técnico: tabela, serviço, papel." },
          "kind": { "enum": ["entity", "system", "actor"] },
          "description": { "type": "string" },
          "source": { "type": "string", "description": "Arquivo de onde o conceito saiu." },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string" },
                "pk": { "type": "boolean" },
                "fk": { "type": "string", "description": "code do conceito apontado." },
                "values": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string", "description": "Verbo do conceitual, lido de `from` para `to` (\"realiza\")." },
          "cardinality": {
            "type": "array",
            "items": { "enum": ["1", "0..1", "0..*", "1..*"] },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "actor": { "type": "string", "description": "Quem executa (texto livre)." },
          "trigger": { "type": "string", "description": "O que dispara o fluxo." },
          "outcome": { "type": "string", "description": "Como o fluxo termina." },
          "variantOf": { "type": "string", "description": "id do fluxo principal." },
          "sources": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "from", "action"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "from": { "type": "string", "description": "Conceito que age." },
                "to": { "type": "string", "description": "Conceito afetado; ausente quando o passo acontece dentro de `from`." },
                "action": { "type": "string", "description": "Verbo curto que vai na seta." },
                "description": { "type": "string", "description": "Markdown curto: **negrito**, `código`, _itálico_." },
                "changes": { "type": "array", "items": { "type": "string" }, "description": "Mudanças de estado: \"Pedido: `paid → refunded`\"." },
                "rules": { "type": "array", "items": { "type": "string" } },
                "errors": { "type": "array", "items": { "type": "string" }, "description": "Mensagens reais, copiadas do código." },
                "also": { "type": "array", "items": { "type": "string" }, "description": "Outros conceitos que o passo lê ou grava." },
                "source": { "type": "string", "description": "Arquivo e, se ajudar, linha." }
              }
            }
          }
        }
      }
    }
  }
}
